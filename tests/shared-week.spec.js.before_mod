const { test, expect } = require('@playwright/test');

test.describe('Shared Week State', () => {
  test.beforeEach(async ({ page }) => {
    // Listen for JavaScript errors and console messages
    const errors = [];
    const consoleMessages = [];
    page.on('console', msg => {
      consoleMessages.push(`${msg.type()}: ${msg.text()}`);
      if (msg.type() === 'error') {
        errors.push(`${msg.type()}: ${msg.text()}`);
      }
    });
    page.on('pageerror', err => {
      errors.push(`PAGE ERROR: ${err.message}`);
    });

    // Store for later use
    page._jsErrors = errors;
    page._consoleMessages = consoleMessages;

    // Login as E2E test rep
    await page.goto('/login');
    
    // Wait for login form to be ready
    await page.waitForSelector('form.stack:not(.login-admin-form)', { state: 'attached' });
    
    // Select E2E Test Representative (we know they exist from our setup)
    // First, let's get the correct user_id by selecting the option with the right name
    await page.selectOption('select[name="user_id"]', { label: 'E2E Test Representative' });
    await page.fill('input[name="pin"]', '1234');
    
    // Submit the form
    await page.click('button:has-text("Sign in")');
    
    // Wait for login to complete (redirect to dashboard)
    await page.waitForURL('**/', { waitUntil: 'networkidle' });
    
    // Navigate to the new invoice page
    await page.goto('/invoices/new');
    // Wait for the page to load and invoice form to be available
    await page.waitForSelector('form#invoice-form', { state: 'attached', timeout: 5000 });
  });

  // Helper to ensure all checkboxes are unchecked (no-op if already unchecked)
  async function ensureAllUnchecked(page) {
    const days = ['Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat'];
    for (const day of days) {
      const wageControl = page.locator(`#calc-days .calc-day:has(input[data-day="${day}"])`);
      const wageInput = wageControl.locator('input');

      if (await wageInput.isChecked()) {
        await wageControl.click();
      }

      await expect(wageInput).not.toBeChecked();

      await expect(
        page.locator(`#wage-days input[name="wage_day"][data-day="${day}"]`)
      ).not.toBeChecked();
    }
  }

  test('initial state - both widgets start unchecked and synchronized', async ({ page }) => {
    // Check all days are unchecked in both widgets
    const days = ['Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat'];
    for (const day of days) {
      const wageCalcChecked = await page.locator(`#calc-days input[data-day="${day}"]`).isChecked();
      const wageDaysChecked = await page.locator(`#wage-days input[name="wage_day"][data-day="${day}"]`).isChecked();
      expect(wageCalcChecked).toBeFalsy();
      expect(wageDaysChecked).toBeFalsy();
    }

    // Wage total should be $0.00
    const calcTotal = await page.locator('#calc-total').textContent();
    expect(calcTotal).toBe('$0.00');

    // Breakdown should show prompt
    const calcBreakdown = await page.locator('#calc-breakdown').textContent();
    expect(calcBreakdown).toContain('Select days worked to calculate wages');

    // Add to invoice button should be disabled
    const addBtn = await page.locator('#calc-add');
    expect(await addBtn.isDisabled()).toBeTruthy();

    // weekState should have no worked days
    const weekState = await page.evaluate(() => window.weekState);
    expect(weekState.workedDays).toEqual([]);
    // No duplicate days
    expect(new Set(weekState.workedDays).size).toBe(weekState.workedDays.length);
  });

  test('week date populates both widgets', async ({ page }) => {
    // Check that the week start date is populated in both widgets
    const weekStartInput = await page.locator('#week_start').inputValue();
    const weekStartDisplay = await page.locator('#calc-week-range').textContent(); // This shows "Week of 24–28 Aug 2026"
    
    expect(weekStartInput).toMatch(/\d{4}-\d{2}-\d{2}/);
    // The display shows formatted date range, not ISO date - so check for the formatted format
    expect(weekStartDisplay).toMatch(/Week of \d{2}–\d{2} [A-Za-z]{3} \d{4}/);
  });

  test('toggle in Wage Calculator updates Dates & Notes', async ({ page }) => {
    await ensureAllUnchecked(page);
    
    // Click Mon label in calc-days (was unchecked, now checked)
    await page.locator('#calc-days .calc-day:has(input[data-day="Mon"])').click();
    await page.waitForTimeout(100);
    
    // Check that Monday is now CHECKED in Dates & Notes (synced from wage calc)
    const monCheckbox = await page.locator('#wage-days input[name="wage_day"][data-day="Mon"]');
    expect(await monCheckbox.isChecked()).toBeTruthy();
    
    // Click again to uncheck
    await page.locator('#calc-days .calc-day:has(input[data-day="Mon"])').click();
    await page.waitForTimeout(100);
    
    // Now it should be unchecked in both
    expect(await monCheckbox.isChecked()).toBeFalsy();
    
    // Check that the date range updated
    const weekStartInput = await page.locator('#week_start').inputValue();
    expect(weekStartInput).toMatch(/\d{4}-\d{2}-\d{2}/);
  });

  test('toggle in Dates & Notes updates Wage Calculator', async ({ page }) => {
    await ensureAllUnchecked(page);
    
    // Toggle Wednesday in Dates & Notes (starts unchecked)
    await page.locator('#wage-days input[name="wage_day"][data-day="Wed"]').click();
    await page.waitForTimeout(100);
    
    // Check that Wednesday is now selected in Wage Calculator
    const wedInCalcDays = await page.locator('#calc-days input[data-day="Wed"]').first();
    expect(await wedInCalcDays.isChecked()).toBeTruthy();
    
    // Click again to uncheck
    await page.locator('#wage-days input[name="wage_day"][data-day="Wed"]').click();
    await page.waitForTimeout(100);
    
    // Now both should be unchecked
    expect(await wedInCalcDays.isChecked()).toBeFalsy();
    
    // Check that the date range updated
    const weekStartInput = await page.locator('#week_start').inputValue();
    expect(weekStartInput).toMatch(/\d{4}-\d{2}-\d{2}/);
  });

  test('untoggling synchronises both widgets', async ({ page }) => {
    await ensureAllUnchecked(page);
    
    // Check Tue and Thu in Wage Calculator ONLY (not in wage-days, since that would double-toggle)
    await page.locator('#calc-days .calc-day:has(input[data-day="Tue"])').click();
    await page.locator('#calc-days .calc-day:has(input[data-day="Thu"])').click();
    await page.waitForTimeout(100);
    
    // Both Tue and Thu should now be checked in BOTH widgets (synced)
    expect(await page.locator('#calc-days input[data-day="Tue"]').isChecked()).toBeTruthy();
    expect(await page.locator('#calc-days input[data-day="Thu"]').isChecked()).toBeTruthy();
    expect(await page.locator('#wage-days input[name="wage_day"][data-day="Tue"]').isChecked()).toBeTruthy();
    expect(await page.locator('#wage-days input[name="wage_day"][data-day="Thu"]').isChecked()).toBeTruthy();
    
    // Now untoggle Tuesday in Wage Calculator
    await page.locator('#calc-days .calc-day:has(input[data-day="Tue"])').click();
    await page.waitForTimeout(100);
    
    // Check that Tuesday is untoggled in both
    const tueCalcCheckbox = await page.locator('#calc-days input[data-day="Tue"]');
    const tueWageCheckbox = await page.locator('#wage-days input[name="wage_day"][data-day="Tue"]');
    expect(await tueCalcCheckbox.isChecked()).toBeFalsy();
    expect(await tueWageCheckbox.isChecked()).toBeFalsy();
    
    // Thursday should remain checked
    expect(await page.locator('#calc-days input[data-day="Thu"]').isChecked()).toBeTruthy();
    expect(await page.locator('#wage-days input[name="wage_day"][data-day="Thu"]').isChecked()).toBeTruthy();
    
    // Check that the date range updated
    const weekStartInput = await page.locator('#week_start').inputValue();
    expect(weekStartInput).toMatch(/\d{4}-\d{2}-\d{2}/);
  });

  test('complete three-day wage calculation', async ({ page }) => {
    await ensureAllUnchecked(page);
    
    // Now check Mon, Wed, Fri in wage calculator
    await page.locator('#calc-days .calc-day:has(input[data-day="Mon"])').click();
    await page.locator('#calc-days .calc-day:has(input[data-day="Wed"])').click();
    await page.locator('#calc-days .calc-day:has(input[data-day="Fri"])').click();
    await page.waitForTimeout(100);
    
    // Check that days are selected in Dates & Notes
    expect(await page.locator('#wage-days input[name="wage_day"][data-day="Mon"]').isChecked()).toBeTruthy();
    expect(await page.locator('#wage-days input[name="wage_day"][data-day="Wed"]').isChecked()).toBeTruthy();
    expect(await page.locator('#wage-days input[name="wage_day"][data-day="Fri"]').isChecked()).toBeTruthy();
    
    // Tue, Thu, Sat should be unchecked
    expect(await page.locator('#wage-days input[name="wage_day"][data-day="Tue"]').isChecked()).toBeFalsy();
    expect(await page.locator('#wage-days input[name="wage_day"][data-day="Thu"]').isChecked()).toBeFalsy();
    expect(await page.locator('#wage-days input[name="wage_day"][data-day="Sat"]').isChecked()).toBeFalsy();
    
    // Check that wage calculator shows correct calculation
    const calcTotal = await page.locator('#calc-total').textContent();
    const calcBreakdown = await page.locator('#calc-breakdown').textContent();
    expect(calcTotal).toContain('$');
    expect(calcBreakdown).toContain('Mon');
    expect(calcBreakdown).toContain('Wed');
    expect(calcBreakdown).toContain('Fri');
    // Should show 3 days worth
    expect(calcBreakdown).toMatch(/3 days|→/);
  });

  test('add the shared week to the invoice', async ({ page }) => {
    await ensureAllUnchecked(page);
    
    // Set up a shared week (Mon, Wed, Fri)
    await page.locator('#calc-days .calc-day:has(input[data-day="Mon"])').click();
    await page.locator('#calc-days .calc-day:has(input[data-day="Wed"])').click();
    await page.locator('#calc-days .calc-day:has(input[data-day="Fri"])').click();
    await page.waitForTimeout(100);
    
    // Add customer details
    await page.fill('#customer_name', 'Test Customer');
    await page.fill('#customer_address', '123 Test Street');
    await page.fill('#notes', 'Test notes');
    
    // Click add item button to add wage line
    await page.click('#calc-add');
    await page.waitForTimeout(100);
    
    // Verify item was added - find the wage line by its stable attribute
    const wageRow = page.locator('[data-line-item-type="wages"]').first();
    expect(await wageRow.isVisible()).toBeTruthy();
    
    // The wage line should have the correct rate (3 * 181.82 = 545.46)
    const wageLineRate = await wageRow.locator('input[name="item_rate"]').inputValue();
    expect(wageLineRate).toContain('545.46'); // 3 * 181.82
    
    // Submit the invoice - use the save draft button
    await page.click('#submit-draft');
    await page.waitForTimeout(1000);
    
    // Check that we're redirected to view the invoice or see success message
    // Either we're on an invoice view page or we see a flash message
    const url = page.url();
    const flashSuccess = await page.locator('.flash-success').isVisible();
    
    expect(url.includes('/invoices/') || flashSuccess).toBeTruthy();
  });

  test('changing week start does not clear selected days', async ({ page }) => {
    await ensureAllUnchecked(page);
    
    // Set up initial shared week - CLICK THE LABELS to check Mon and Wed
    await page.locator('#calc-days .calc-day:has(input[data-day="Mon"])').click();
    await page.locator('#calc-days .calc-day:has(input[data-day="Wed"])').click();
    await page.waitForTimeout(100);
    
    // Store initial selections
    const monChecked = await page.locator('#calc-days input[data-day="Mon"]').isChecked();
    const wedChecked = await page.locator('#calc-days input[data-day="Wed"]').isChecked();
    
    // Change the week start date (this should trigger recalculation)
    const newWeekStart = '2026-08-31'; // A Monday
    await page.fill('#week_start', newWeekStart);
    await page.waitForTimeout(100);
    
    // After changing week start, the checkboxes may be recreated, so we need to re-locate them
    // Check that selections are preserved by finding the checkboxes again
    const monCheckboxAfter = page.locator('#calc-days input[data-day="Mon"]');
    const wedCheckboxAfter = page.locator('#calc-days input[data-day="Wed"]');
    
    // Wait for the checkboxes to be available again
    await monCheckboxAfter.waitFor({ state: 'attached', timeout: 2000 });
    await wedCheckboxAfter.waitFor({ state: 'attached', timeout: 2000 });
    
    // Check that selections are preserved
    expect(await monCheckboxAfter.isChecked()).toBe(monChecked);
    expect(await wedCheckboxAfter.isChecked()).toBe(wedChecked);
    
    // Check that the week start input shows our new value
    const weekStartInput = await page.locator('#week_start').inputValue();
    expect(weekStartInput).toBe(newWeekStart);
  });
});