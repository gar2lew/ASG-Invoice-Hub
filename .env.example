PORT=3000

# Postgres database. Free tiers: Neon (neon.tech) or Supabase.
DATABASE_URL=postgres://user:password@host:5432/dbname
# Set DATABASE_SSL=false only for a local Postgres without SSL.
DATABASE_SSL=true

SESSION_SECRET=change-me-to-a-long-random-string

# First-run admin account
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme
ADMIN_EMAIL=

# Email (SMTP). Invoice sending needs these. Leave SMTP_HOST empty to disable sending.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Invoice Hub <invoices@example.com>"
