<%- include('partials/head', { title }) %>

<header class="page-head">
  <div>
    <p class="kicker">Administration</p>
    <h1 class="page-title">Sales reps</h1>
  </div>
</header>

<div class="form-cols">
  <div class="form-col">
    <section class="card">
      <div class="card-head">
        <h2 class="card-title">Users</h2>
        <p class="card-sub">All accounts in the system.</p>
      </div>
      <div class="table-wrap">
        <table class="user-table">
          <thead>
            <tr><th>Rep</th><th>Contact</th><th>ABN</th><th>Bank details</th><th>Status</th><th>Created</th><th class="actions"><span class="sr-only">Actions</span></th></tr>
          </thead>
          <tbody>
            <% users.forEach(function(u) { %>
            <tr>
              <td>
                <span class="cell-main"><%= u.name %></span>
                <span class="cell-sub"><%= u.role %></span>
              </td>
              <td>
                <% if (u.email) { %><span class="cell-main"><%= u.email %></span><% } %>
                <% if (u.phone) { %><span class="cell-sub"><%= u.phone %></span><% } %>
                <% if (!u.email && !u.phone) { %><span class="muted">—</span><% } %>
              </td>
              <td class="mono muted"><%= u.abn || '—' %></td>
              <td>
                <% if (u.bank_name && u.bank_bsb && u.bank_account) { %>
                  <span class="badge badge-paid">Complete</span>
                <% } else { %>
                  <span class="badge badge-draft">Missing</span>
                <% } %>
              </td>
              <td>
                <% if (u.is_active === false) { %>
                  <span class="badge badge-danger">Inactive</span>
                <% } else { %>
                  <span class="badge badge-success">Active</span>
                <% } %>
              </td>
              <td class="muted"><%= u.createdText %></td>
              <td class="actions">
                <% if (u.role !== 'admin') { %>
                  <a class="btn btn-ghost btn-tiny" href="/users/<%= u.id %>/edit">Edit</a>
                  <% if (u.is_active !== false) { %>
                    <form method="post" action="/users/<%= u.id %>/deactivate" class="inline-form" onsubmit="return confirm('Deactivate <%= u.name %>? They will no longer be able to log in.');">
                      <button class="btn btn-warning btn-tiny" type="submit">Deactivate</button>
                    </form>
                  <% } else { %>
                    <form method="post" action="/users/<%= u.id %>/reactivate" class="inline-form">
                      <button class="btn btn-success btn-tiny" type="submit">Reactivate</button>
                    </form>
                  <% } %>
                  <form method="post" action="/users/<%= u.id %>/reset-pin" class="inline-form">
                    <input class="input input-sm" type="text" name="pin" placeholder="New PIN" pattern="\d{4}" maxlength="4" minlength="4" required>
                    <button class="btn btn-ghost btn-tiny" type="submit">Reset PIN</button>
                  </form>
                <% } %>
                <% if (u.id !== currentUser.id) { %>
                  <form method="post" action="/users/<%= u.id %>/delete" class="inline-form" onsubmit="return confirm('Remove <%= u.name %>? This cannot be undone.');">
                    <button class="btn btn-danger btn-tiny" type="submit">Remove</button>
                  </form>
                <% } %>
              </td>
            </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </section>
  </div>

  <div class="form-col">
    <div class="create-account-grid">
      <section class="card">
        <div class="card-head">
          <h2 class="card-title">Add a rep</h2>
          <p class="card-sub">They&rsquo;ll sign in with their name and a 4-digit PIN.</p>
        </div>
        <form method="post" action="/admin/users/create-rep">
          <label class="field">
            <span class="field-label">Full name <em>*</em></span>
            <input class="input" type="text" name="name" required>
          </label>
          <label class="field">
            <span class="field-label">Email</span>
            <input class="input" type="email" name="email">
          </label>
          <label class="field">
            <span class="field-label">ABN</span>
            <input class="input" type="text" name="abn">
          </label>
          <label class="field"><span class="field-label">Bank name</span><input class="input" type="text" name="bank_name"></label>
          <label class="field"><span class="field-label">BSB</span><input class="input" type="text" name="bank_bsb" inputmode="numeric"></label>
          <label class="field"><span class="field-label">Account number</span><input class="input" type="text" name="bank_account" inputmode="numeric"></label>
          <label class="field">
            <span class="field-label">PIN <em>*</em></span>
            <input class="input" type="text" name="pin" pattern="\d{4}" maxlength="4" minlength="4" required>
          </label>
          <button class="btn btn-accent btn-block" type="submit">Create rep account</button>
        </form>
      </section>

      <section class="card">
        <div class="card-head">
          <h2 class="card-title">Add an admin</h2>
          <p class="card-sub">They&rsquo;ll sign in with a username and password.</p>
        </div>
        <form method="post" action="/admin/users/create-admin">
          <label class="field">
            <span class="field-label">Full name <em>*</em></span>
            <input class="input" type="text" name="name" required>
          </label>
          <label class="field">
            <span class="field-label">Username <em>*</em></span>
            <input class="input" type="text" name="username" id="create-admin-username" required>
          </label>
          <label class="field">
            <span class="field-label">Password <em>*</em></span>
            <input class="input" type="password" name="password" id="create-admin-password" required>
          </label>
          <label class="field">
            <span class="field-label">Email</span>
            <input class="input" type="email" name="email" id="create-admin-email">
          </label>
          <button class="btn btn-accent btn-block" type="submit" id="create-admin-submit">Create admin account</button>
        </form>
      </section>
    </div>
  </div>
</div>

<%- include('partials/footer') %>
