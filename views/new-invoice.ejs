<%- include('partials/head', { title }) %>

<header class="page-head">
  <div>
    <p class="kicker">New record</p>
    <h1 class="page-title">Create invoice</h1>
  </div>
</header>

<form id="invoice-form" class="invoice-form" method="post" action="/api/invoices" data-next-number="<%= settings.invoice_prefix %>">
  <section class="card">
    <div class="card-head">
      <h2 class="card-title">Company template</h2>
      <p class="card-sub">Pick which company this invoice is for.</p>
    </div>
    <div class="tpl-toggle" role="radiogroup" aria-label="Invoice template">
      <button type="button" class="tpl" data-template="asg" role="radio" aria-checked="false">
        <span class="tpl-preview tpl-preview-asg" aria-hidden="true">
          <span class="pv-p1"></span><span class="pv-block"></span><span class="pv-rows"><i></i><i></i><i></i></span><span class="pv-tot"></span>
        </span>
        <span class="tpl-meta">
          <span class="tpl-name">ASG</span>
          <span class="tpl-desc">Amplify Solutions Group</span>
          <span class="tpl-tag">Default</span>
        </span>
      </button>
      <button type="button" class="tpl" data-template="sjs" role="radio" aria-checked="false">
        <span class="tpl-preview tpl-preview-sjs" aria-hidden="true">
          <span class="pv-band"></span><span class="pv-block"></span><span class="pv-rows pv-rows-slim"><i></i><i></i><i></i></span><span class="pv-tot"></span>
        </span>
        <span class="tpl-meta">
          <span class="tpl-name">SJS</span>
          <span class="tpl-desc">SJS Wealth Solutions</span>
          <span class="tpl-tag">Wealth</span>
        </span>
      </button>
      <input type="hidden" name="template" value="asg">
    </div>
  </section>

  <div class="form-cols">
    <!-- LEFT COLUMN ~60% -->
    <div class="form-col">
      <!-- Invoice Details -->
      <section class="card">
        <div class="card-head">
          <h2 class="card-title">Invoice details</h2>
          <p class="card-sub">Invoice number and client information.</p>
        </div>
        <div class="grid2">
          <label class="field">
            <span class="field-label">Invoice number</span>
            <input class="input" type="text" name="invoice_number" id="invoice_number" value="<%= nextNumber %>">
          </label>
          <label class="field">
            <span class="field-label">Email</span>
            <input class="input" type="email" name="customer_email" id="customer_email" value="<%= typeof customer_email !== 'undefined' && customer_email ? customer_email : '' %>">
          </label>
        </div>
        <label class="field">
          <span class="field-label">Company name <em>*</em></span>
          <input class="input" type="text" name="customer_name" id="customer_name" required value="<%= typeof customer_name !== 'undefined' && customer_name ? customer_name : '' %>"/>
        </label>
        <label class="field">
          <span class="field-label">Address</span>
          <textarea class="input" name="customer_address" id="customer_address" rows="2"><%= typeof customer_address !== 'undefined' && customer_address ? customer_address : '' %></textarea>
        </label>
      </section>

      <!-- Weekly Wage Calculator -->
            <section class="card card-calc">
              <div class="card-head">
                <h2 class="card-title">Weekly wage calculator</h2>
                <p class="card-sub">Select days worked, then add as a line item.</p>
              </div>
              <div id="calc-week-range" class="week-range-display"></div>

              <!-- Rate display -->
                            <div class="calc-rate-display">
                              <span class="rate-label">Rate</span>
                              <span class="rate-value" id="calc-rate-display">$200.00 / day</span>
                            </div>
                            <!-- Hidden rate input for JS compatibility -->
                            <input type="hidden" id="calc-rate" name="calc_rate" value="200">

              <!-- Standard Week -->
              <div class="calc-section">
                <h3 class="calc-section-title">Standard Week (Mon–Fri)</h3>
                <div class="calc-days" id="calc-days-standard">
                  <label class="calc-day"><input type="checkbox" data-day="Mon"><span>Mon</span></label>
                  <label class="calc-day"><input type="checkbox" data-day="Tue"><span>Tue</span></label>
                  <label class="calc-day"><input type="checkbox" data-day="Wed"><span>Wed</span></label>
                  <label class="calc-day"><input type="checkbox" data-day="Thu"><span>Thu</span></label>
                  <label class="calc-day"><input type="checkbox" data-day="Fri"><span>Fri</span></label>
                </div>
                <div class="calc-section-actions">
                  <button type="button" class="btn btn-ghost btn-small" id="select-mon-fri">Select Mon–Fri</button>
                </div>
              </div>

              <!-- Saturday Extra -->
              <div class="calc-section calc-section-sat">
                <h3 class="calc-section-title">Saturday Extra</h3>
                <div class="calc-days" id="calc-days-sat">
                  <label class="calc-day calc-day-half"><input type="checkbox" data-day="Sat" value="0.5"><span>Saturday <em>&frac12;</em> day</span></label>
                </div>
                <div class="calc-sat-hint">Adds <span id="sat-amount">$100.00</span> to weekly total</div>
              </div>

              <div class="calc-result">
                              <div class="calc-total-row">
                                <span class="calc-total-label">Week Total</span>
                                <span class="calc-total" id="calc-total">$0.00</span>
                              </div>
                              <div id="calc-breakdown" class="calc-breakdown muted"><span>Select days worked to calculate wages.</span></div>
                              <button type="button" class="btn btn-accent btn-small" id="calc-add">Add to invoice</button>
                            </div>

              <!-- Week start date - visible for date selection -->
              <div class="field week-start-field">
                <label for="week_start">Week starting</label>
                <input type="date" name="week_start" id="week_start" value="<%= issueDate %>">
              </div>
            </section>

            <!-- Dates & Notes (Compact Grid) -->
                        <section class="card">
                          <div class="card-head">
                            <h2 class="card-title">Dates & Notes</h2>
                            <p class="card-sub">Verify dates for selected days.</p>
                          </div>
                          <div class="wage-dates-grid" id="wage-days">
                                          <div class="wage-day-tile" data-day="Mon">
                                            <label class="wage-day-check"><input type="checkbox" name="wage_day" data-day="Mon"><span>Mon</span></label>
                                            <div class="wage-day-date"><span class="wage-date-display">—</span><input class="input input-sm wage-date" type="date" name="date_Mon" hidden></div>
                                          </div>
                                          <div class="wage-day-tile" data-day="Tue">
                                            <label class="wage-day-check"><input type="checkbox" name="wage_day" data-day="Tue"><span>Tue</span></label>
                                            <div class="wage-day-date"><span class="wage-date-display">—</span><input class="input input-sm wage-date" type="date" name="date_Tue" hidden></div>
                                          </div>
                                          <div class="wage-day-tile" data-day="Wed">
                                            <label class="wage-day-check"><input type="checkbox" name="wage_day" data-day="Wed"><span>Wed</span></label>
                                            <div class="wage-day-date"><span class="wage-date-display">—</span><input class="input input-sm wage-date" type="date" name="date_Wed" hidden></div>
                                          </div>
                                          <div class="wage-day-tile" data-day="Thu">
                                            <label class="wage-day-check"><input type="checkbox" name="wage_day" data-day="Thu"><span>Thu</span></label>
                                            <div class="wage-day-date"><span class="wage-date-display">—</span><input class="input input-sm wage-date" type="date" name="date_Thu" hidden></div>
                                          </div>
                                          <div class="wage-day-tile" data-day="Fri">
                                            <label class="wage-day-check"><input type="checkbox" name="wage_day" data-day="Fri"><span>Fri</span></label>
                                            <div class="wage-day-date"><span class="wage-date-display">—</span><input class="input input-sm wage-date" type="date" name="date_Fri" hidden></div>
                                          </div>
                                          <div class="wage-day-tile wage-day-tile-sat" data-day="Sat">
                                            <label class="wage-day-check"><input type="checkbox" name="wage_day" data-day="Sat"><span>Sat</span></label>
                                            <div class="wage-day-date"><span class="wage-date-display">—</span><input class="input input-sm wage-date" type="date" name="date_Sat" hidden></div>
                                            <div class="wage-day-half">½ day</div>
                                          </div>
                                        </div>

              <label class="field" style="margin-top: 16px;">
                <span class="field-label">Notes</span>
                <textarea class="input" name="notes" id="notes" rows="2" placeholder="Optional message shown on the invoice"></textarea>
              </label>
            </section>
    </div>

    <!-- RIGHT COLUMN ~40% -->
    <div class="form-col">
      <!-- Line Items -->
      <section class="card">
        <div class="card-head">
          <h2 class="card-title">Line items</h2>
          <button type="button" class="btn btn-ghost btn-small" id="add-line">
            <svg aria-hidden="true" viewBox="0 0 16 16" width="14" height="14"><path d="M8 3v10M3 8h10" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
            Add line
          </button>
        </div>
        <div class="lines" id="lines">
          <div class="line-row line-head" aria-hidden="true">
            <span>Description</span><span>Qty</span><span>Rate</span><span class="num">Amount</span><span></span>
          </div>
        </div>
        <div class="totals">
          <div class="total-row">
            <span>Subtotal</span>
            <span class="mono" id="t-subtotal">$0.00</span>
          </div>
          <label class="gst-toggle">
            <input type="checkbox" name="gst" id="gst">
            <span>Add GST (10%)</span>
          </label>
          <div class="total-row total-row-gst" id="gst-row" hidden>
            <span>GST</span>
            <span class="mono" id="t-gst">$0.00</span>
          </div>
          <div class="total-row total-row-grand">
            <span>Total</span>
            <span class="mono" id="t-total">$0.00</span>
          </div>
        </div>
      </section>

      <!-- Actions -->
      <section class="card card-actions">
        <label class="checkline">
          <input type="checkbox" name="send_now" id="send_now" checked>
          <span>Open an email to Natalie after saving (you&rsquo;ll attach the downloaded PDF)</span>
        </label>
        <div class="actions-row">
          <input type="hidden" name="action" id="action-field" value="draft">
          <button type="button" class="btn btn-ghost" id="submit-download" data-action="download">Download PDF</button>
          <button type="submit" class="btn btn-ghost" id="submit-draft" data-action="draft">Save draft</button>
          <button type="submit" class="btn btn-ink" id="submit-send" data-action="save">Save</button>
          <button type="submit" class="btn btn-accent" id="submit-send-email" data-action="send">Send & email</button>
        </div>
      </section>

      <!-- Invoice Preview -->
      <section class="card preview-card">
        <div class="card-head">
          <h2 class="card-title">Invoice preview</h2>
          <p class="card-sub">Live preview of your invoice.</p>
        </div>
        <div class="preview-page" id="preview-page">
          <div class="preview-header">
            <div class="preview-company">
              <div class="preview-company-name" id="pv-company"><%= repName %></div>
              <div class="preview-company-sub" id="pv-company-sub"><% if (repAbn) { %>ABN <%= repAbn %><% } %></div>
            </div>
            <div class="preview-invoice-label">INVOICE</div>
            <div class="preview-invoice-num" id="pv-inv-num"><%= nextNumber %></div>
          </div>
          <div class="preview-divider"></div>
          <div class="preview-rep-details" id="pv-rep-details"></div>
          <div class="preview-body">
            <div class="preview-billto">
              <div class="preview-label">BILL TO</div>
              <div class="preview-client-name" id="pv-client-name"></div>
              <div class="preview-client-contact" id="pv-client-contact"></div>
              <div class="preview-client-email" id="pv-client-email"></div>
              <div class="preview-client-address" id="pv-client-address"></div>
            </div>
            <div class="preview-meta">
              <div class="preview-meta-row">
                <span class="preview-label">ISSUE DATE</span>
                <span id="pv-issue-date"><%= issueDate %></span>
              </div>
              <div class="preview-meta-row">
                <span class="preview-label">DUE DATE</span>
                <span id="pv-due-date"><%= dueDate %></span>
              </div>
            </div>
          </div>
          <div class="preview-divider"></div>
          <table class="preview-items">
            <thead>
              <tr>
                <th>#</th>
                <th>Description</th>
                <th class="num">Qty</th>
                <th class="num">Rate</th>
                <th class="num">Amount</th>
              </tr>
            </thead>
            <tbody id="pv-items">
              <tr class="preview-empty"><td colspan="5">No items yet</td></tr>
            </tbody>
          </table>
          <div class="preview-divider"></div>
          <div class="preview-totals">
            <div class="preview-total-row">
              <span>Subtotal</span>
              <span id="pv-subtotal">$0.00</span>
            </div>
            <div class="preview-total-row preview-total-gst" id="pv-gst-row" style="display:none">
              <span>GST (10%)</span>
              <span id="pv-gst">$0.00</span>
            </div>
            <div class="preview-total-row preview-total-grand">
              <span>TOTAL</span>
              <span id="pv-total">$0.00</span>
            </div>
          </div>
          <div class="preview-footer">
            <div id="pv-notes"></div>
          </div>
        </div>
      </section>
    </div>
  </div>
</form>
<% if (typeof existingItems !== 'undefined') { %>
<script>
  window.existingItems = <%- JSON.stringify(existingItems) %>;
</script>
<% } %>
<script>window.invoiceRepName = <%- JSON.stringify(repName) %>; window.invoiceRepDetails = <%- JSON.stringify({ name: repName, abn: repAbn, email: currentUser && currentUser.email, bankName: currentUser && currentUser.bank_name, bankBsb: currentUser && currentUser.bank_bsb, bankAccount: currentUser && currentUser.bank_account }) %>;</script>
<%- include('partials/footer', { pageScript: '/js/invoice-form.js' }) %>
