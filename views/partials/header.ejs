<aside class="sidebar">
  <a class="brand" href="/">
    <span class="brand-mark">INV</span>
    <span class="brand-text">
      <span class="brand-name">Invoice&nbsp;Hub</span>
      <span class="brand-tag">Sales &middot; Accounts</span>
    </span>
  </a>

  <nav class="nav" aria-label="Main">
    <a class="nav-link" href="/">
      <svg aria-hidden="true" viewBox="0 0 16 16" width="15" height="15"><rect x="1.5" y="1.5" width="5" height="5" rx="1"/><rect x="9.5" y="1.5" width="5" height="5" rx="1"/><rect x="1.5" y="9.5" width="5" height="5" rx="1"/><rect x="9.5" y="9.5" width="5" height="5" rx="1"/></svg>
      Dashboard
    </a>
    <a class="nav-link nav-link-cta" href="/invoices/new">
      <svg aria-hidden="true" viewBox="0 0 16 16" width="15" height="15"><path d="M8 3v10M3 8h10" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
      New invoice
    </a>
  </nav>

  <% if (currentUser && currentUser.role === 'admin') { %>
    <p class="nav-sec">Administration</p>
    <nav class="nav" aria-label="Administration">
      <a class="nav-link" href="/settings">
        <svg aria-hidden="true" viewBox="0 0 16 16" width="15" height="15"><circle cx="8" cy="8" r="2.6"/><path d="M8 1.8v2M8 12.2v2M1.8 8h2M12.2 8h2M3.6 3.6l1.4 1.4M11 11l1.4 1.4M12.4 3.6L11 5M5 11l-1.4 1.4" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"/></svg>
        Settings
      </a>
      <a class="nav-link" href="/users">
        <svg aria-hidden="true" viewBox="0 0 16 16" width="15" height="15"><circle cx="6" cy="5.5" r="2.6"/><path d="M1.5 13.5c.6-2.6 2.4-4 4.5-4s3.9 1.4 4.5 4M11 3.6a2.6 2.6 0 0 1 0 3.8M12 9.7c1.5.5 2.4 1.8 2.7 3.8" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"/></svg>
        Sales reps
      </a>
    </nav>
  <% } %>

  <div class="sidefoot">
    <div class="userchip">
      <span class="userchip-avatar"><%= currentUser.name.charAt(0) %></span>
      <span class="userchip-meta">
        <span class="userchip-name"><%= currentUser.name %></span>
        <span class="userchip-role"><%= currentUser.role === 'admin' ? 'Administrator' : 'Sales rep' %></span>
      </span>
    </div>
    <form method="post" action="/logout">
      <button class="btn btn-ghost btn-small btn-block" type="submit">Sign out</button>
    </form>
  </div>
</aside>
