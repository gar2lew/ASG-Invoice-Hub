<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= title %> · Invoice Hub</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Archivo:wght@500;600;700;800&family=IBM+Plex+Mono:wght@400;500;600&family=Source+Sans+3:wght@400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
  <script src="/js/theme.js"></script>
</head>
<body>
<div class="shell">
  <%- include('header') %>
  <main class="content">
    <% if (flash) { %>
      <div class="flash flash-<%= flash.type %>" role="status"><%= flash.text %></div>
    <% } %>

    <!-- Mobile Header -->
    <div class="mobile-header">
      <div class="mobile-header-brand">
        <span class="brand-mark">INV</span>
        <span class="mobile-header-title">Invoice Hub</span>
      </div>
      <div class="mobile-header-actions">
        <button id="theme-toggle-mobile" class="theme-toggle" type="button" aria-label="Toggle theme">
          <svg aria-hidden="true" viewBox="0 0 16 16"><path d="M11.5 4.5a6 6 0 0 1-9 9 6 6 0 1 0 9-9z" fill="currentColor"/></svg>
        </button>
      </div>
    </div>

    <!-- Mobile Bottom Nav -->
    <nav class="mobile-bottom-nav" aria-label="Mobile navigation">
      <a class="bottom-nav-item" href="/">
        <svg aria-hidden="true" viewBox="0 0 16 16" width="15" height="15"><rect x="1.5" y="1.5" width="5" height="5" rx="1"/><rect x="9.5" y="1.5" width="5" height="5" rx="1"/><rect x="1.5" y="9.5" width="5" height="5" rx="1"/><rect x="9.5" y="9.5" width="5" height="5" rx="1"/></svg>
        Dashboard
      </a>
      <a class="bottom-nav-item" href="/invoices/new">
        <svg aria-hidden="true" viewBox="0 0 16 16" width="15" height="15"><path d="M8 3v10M3 8h10" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
        New Invoice
      </a>
      <a class="bottom-nav-item" href="/profile">
        <svg aria-hidden="true" viewBox="0 0 16 16" width="15" height="15"><circle cx="8" cy="5.5" r="2.6"/><path d="M1.5 13.5c.6-2.6 2.4-4 4.5-4s3.9 1.4 4.5 4" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"/></svg>
        My Profile
      </a>
    </nav>
