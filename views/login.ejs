<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Sign in · Invoice Hub</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Archivo:wght@500;600;700;800&family=IBM+Plex+Mono:wght@400;500;600&family=Source+Sans+3:wght@400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body class="login-body">
  <div class="login-wrap">
    <main class="login-card">
      <header class="login-head">
        <span class="brand-mark">INV</span>
        <h1>Invoice Hub</h1>
        <p>Sales rep invoicing, straight to accounts.</p>
      </header>

      <% if (error) { %>
        <div class="flash flash-error" role="alert"><%= error %></div>
      <% } %>
      <% if (flash) { %>
        <div class="flash flash-<%= flash.type %>" role="status"><%= flash.text %></div>
      <% } %>

      <form method="post" action="/login" class="stack">
        <input type="hidden" name="login_type" value="rep">
        <label class="field">
          <span class="field-label">Your name</span>
          <select class="input" name="user_id" required>
            <option value="">Select your name&hellip;</option>
            <% reps.forEach(function(r) { %>
              <option value="<%= r.id %>"><%= r.name %></option>
            <% }) %>
          </select>
        </label>
        <label class="field">
          <span class="field-label">PIN</span>
          <input class="input" type="password" name="pin" inputmode="numeric" pattern="\d{4}" maxlength="4" placeholder="4-digit PIN" required autocomplete="off">
        </label>
        <button class="btn btn-accent btn-block" type="submit">Sign in</button>
      </form>

      <p class="login-divider"><span>or</span></p>

      <form method="post" action="/login" class="stack login-admin-form">
        <input type="hidden" name="login_type" value="admin">
        <p class="login-admin-label">Administrator</p>
        <label class="field">
          <span class="field-label">Username</span>
          <input class="input" type="text" name="username" autocomplete="username">
        </label>
        <label class="field">
          <span class="field-label">Password</span>
          <input class="input" type="password" name="password" autocomplete="current-password">
        </label>
        <button class="btn btn-ghost btn-block" type="submit">Admin sign in</button>
      </form>

      <p class="login-foot"><a href="/signup">Create a rep account</a></p>
    </main>
    <p class="login-foot">Internal tool &middot; contact your administrator for access</p>
  </div>
</body>
</html>
