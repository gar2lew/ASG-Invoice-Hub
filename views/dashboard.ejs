<%- include('partials/head', { title }) %>

<header class="page-head">
  <div>
    <p class="kicker"><%= todayText %></p>
    <h1 class="page-title">Good <%= new Date().getHours() < 12 ? 'morning' : new Date().getHours() < 18 ? 'afternoon' : 'evening' %>, <%= currentUser.name.split(' ')[0] %></h1>
  </div>
  <a class="btn btn-accent" href="/invoices/new">
    <svg aria-hidden="true" viewBox="0 0 16 16" width="15" height="15"><path d="M8 3v10M3 8h10" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
    Create weekly invoice
  </a>
</header>

<section class="stats" aria-label="Summary">
  <div class="stat stat-accent">
    <span class="stat-label">This week</span>
    <span class="stat-value"><%= weekStats.totalText %></span>
    <span class="stat-note"><%= weekStats.count %> invoice<%= weekStats.count === 1 ? '' : 's' %></span>
  </div>
  <div class="stat">
    <span class="stat-label">All time</span>
    <span class="stat-value"><%= allStats.totalText %></span>
    <span class="stat-note"><%= allStats.count %> invoice<%= allStats.count === 1 ? '' : 's' %></span>
  </div>
  <div class="stat">
    <span class="stat-label">Drafts</span>
    <span class="stat-value stat-mono"><%= statusCounts.draft %></span>
    <span class="stat-note">awaiting send</span>
  </div>
  <div class="stat">
    <span class="stat-label">Sent</span>
    <span class="stat-value stat-mono"><%= statusCounts.sent %></span>
    <span class="stat-note"><%= statusCounts.paid %> marked paid</span>
  </div>
</section>

<% if (draftCount > 0) { %>
  <div class="flash flash-warn weekly-send-banner" role="status">
    <strong>Weekly send:</strong> <%= draftCount %> draft<%= draftCount === 1 ? '' : 's' %> pending &mdash; all invoices should be emailed to <strong><%= weeklySendTo %></strong> every Monday.
  </div>
<% } %>

<% if (showEmpty) { %>
  <div class="card empty">
    <span class="empty-mark">INV</span>
    <h2>No invoices yet</h2>
    <p>Choose the days worked, then save the invoice.</p>
    <a class="btn btn-accent" href="/invoices/new">Create weekly invoice</a>
  </div>
<% } else { %>
  <% if (admin) { %><form id="bulk-delete-invoices" method="post" action="/admin/invoices/delete" onsubmit="return confirm('Permanently delete the selected invoices?');"><% } %>
  <section class="card">
    <div class="card-head">
      <h2 class="card-title">Invoice history</h2>
      <label class="filter">
        <span class="sr-only">Filter by status</span>
        <select class="input input-sm" data-filter-status>
          <option value="">All statuses</option>
          <option value="draft">Draft</option>
          <option value="sent">Sent</option>
          <option value="paid">Paid</option>
        </select>
      </label>
      <% if (admin) { %><button class="btn btn-ghost btn-small" type="submit">Delete selected</button><% } %>
    </div>
    <div class="table-wrap">
      <table class="table">
        <thead>
          <tr>
            <% if (admin) { %><th><input type="checkbox" data-select-all aria-label="Select all invoices"></th><% } %><th>Invoice</th>
            <th>Customer</th>
            <th>Created</th>
            <% if (admin) { %><th>Rep</th><% } %>
            <th>Template</th>
            <th class="num">Total</th>
            <th>Status</th>
            <th class="actions"><span class="sr-only">Actions</span></th>
          </tr>
        </thead>
        <tbody>
          <% invoices.forEach(function(i) { %>
          <tr data-status="<%= i.status %>">
            <% if (admin) { %><td><input type="checkbox" name="delete_ids" value="<%= i.id %>" aria-label="Select <%= i.invoice_number %>"></td><% } %>
            <td class="mono"><a href="/invoices/<%= i.id %>"><%= i.invoice_number %></a></td>
            <td>
              <span class="cell-main"><%= i.customer_name %></span>
              <% if (i.customer_company) { %><span class="cell-sub"><%= i.customer_company %></span><% } %>
            </td>
            <td class="muted"><%= i.createdText %></td>
            <% if (admin) { %><td class="muted"><%= i.rep_name %></td><% } %>
            <td><span class="badge badge-tpl"><%= i.template %></span></td>
            <td class="num mono strong"><%= i.totalText %></td>
            <td><span class="badge badge-<%= i.status %>"><%= i.status %></span></td>
            <td class="actions"><a class="btn btn-ghost btn-tiny" href="/invoices/<%= i.id %>">View</a></td>
          </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </section>
  <% if (admin) { %></form><% } %>

<% } %>

<%- include('partials/footer', { pageScript: '/js/dashboard.js' }) %>
